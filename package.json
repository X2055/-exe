{
  "name": "spore",
  "productName": "Spore",
  "version": "10.0.0",
  "description": "Spore Protocol 孢子协议",
  "main": "main.js",
  "author": "Spore",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.spore.app",
    "productName": "Spore",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "icon.png"],
    "compression": "maximum",
    "win": {
      "icon": "icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": { "artifactName": "Spore.exe" }
  }
}
